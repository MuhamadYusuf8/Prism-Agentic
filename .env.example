# ─── Quick start ───────────────────────────────────────────────
# Copy this file to .env before running `docker compose up`:
#     cp .env.example .env
# The stack also starts without .env (all secrets below fall back
# to safe defaults), but API keys / custom secrets require it.

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=recruitment_pass
POSTGRES_DB=recruitment_db

# ─── Default admin (auto-created on backend startup) ──────────
ADMIN_EMAIL=admin@president.ac.id
ADMIN_PASSWORD=admin123

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Claude / Anthropic ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Brave Search API (free: 2000 queries/month) ───────────────
# Get key at: https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=BSA...

# ─── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@youruniversity.ac.id

# ─── Email Monitoring (IMAP — where replies are received) ─────
# Used by the Email Monitoring module to ingest student replies
# from the admissions mailbox (e.g. mit@president.ac.id).
# For Google Workspace use imap.google.com:993 + App Password.
IMAP_HOST=imap.google.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true

# ─── LinkedIn Scraper ──────────────────────────────────────────
# li_at session cookie (Phase 2 detail enrichment)
LINKEDIN_LI_AT=

# ─── Email Discovery (optional) ────────────────────────────────
# Hunter.io API key — find emails for scraped leads (25 free/mo)
HUNTER_API_KEY=

# ─── App ───────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_32_char_string
ENVIRONMENT=development

# ─── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change_me
NEXTAUTH_URL=http://localhost:3000
