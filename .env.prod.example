# PRISM — Production Environment Variables
# Copy this file to .env.prod and fill in all values before deploying.
# NEVER commit .env.prod to version control!

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=prism_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=prism_production

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── Application Secrets ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHAR_HEX

# ── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# ── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (SMTP via Resend or Gmail) ─────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@president.ac.id
EMAIL_FROM_NAME=PRISM - President University

# ── Scraping APIs ─────────────────────────────────────────────────────────────
SERPER_API_KEY=...
SCRAPIN_API_KEY=...

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://prism.president.ac.id"]

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Default Admin (seeded on first boot) ─────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@president.ac.id
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DEFAULT_ADMIN_NAME=System Administrator
